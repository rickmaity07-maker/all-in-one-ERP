{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Android: the update check reads the latest release from GitHub through the app (no browser rate limits or CORS)",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://github.com/rickmaity07-maker/all-in-one-ERP/*" }, { "url": "https://*.githubusercontent.com/*" }]
    }
  ]
}
